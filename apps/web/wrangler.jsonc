// Cloudflare Workers static assets: serves the exported site from `out/`. Free, no server code.
//   pnpm --filter @felt/web build && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "felt",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
