# Game server (production). Copy to deploy/.env — never commit the real file.

# Public HTTPS URL of the game server (the Cloudflare Tunnel hostname).
PUBLIC_URL=https://api.example.com
# The website's origin(s), comma-separated. Used for CORS and sign-in redirects.
WEB_ORIGINS=https://example.com

# Neon: Dashboard → Connect → connection string (keep ?sslmode=require).
DATABASE_URL=postgres://user:password@ep-xxxx.region.aws.neon.tech/felt?sslmode=require
# Upstash: Database → Connect → ioredis / TCP URL (rediss://).
REDIS_URL=rediss://default:password@xxxx.upstash.io:6379

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application).
# Authorized redirect URI: <PUBLIC_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Zero Trust → Networks → Tunnels → your tunnel → token.
# Public hostname api.example.com → service http://server:4000
TUNNEL_TOKEN=

# Optional
# MAX_ROOMS=500
