# Local development. `docker compose up -d db redis`, then copy this to apps/server/.env
DATABASE_URL=postgres://felt:felt@localhost:5432/felt
REDIS_URL=redis://localhost:6380
WEB_ORIGINS=http://localhost:3000
PUBLIC_URL=http://localhost:4000
# Sign in by name without Google (local only, ignored in production).
DEV_LOGIN=1
# To test real Google sign-in locally, add http://localhost:4000/auth/google/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web app (apps/web/.env.local)
# NEXT_PUBLIC_SERVER_URL=http://localhost:4000
